---
layout: null
---
[
  {% for article in site.articles %}
    {% assign creator_names = "" | split: "" %}
    {% for creator_slug in article.creators %}
      {% assign creator_data = site.data.creators | where: "slug", creator_slug | first %}
      {% assign display_name = creator_data.name | default: creator_slug %}
      {% assign creator_names = creator_names | push: display_name %}
    {% endfor %}
    {
      "title"      : {{ article.title | jsonify }},
      "url"        : {{ article.url | jsonify }},
      "subjects"   : {{ article.subjects | join: ', ' | jsonify }},
      "categories" : {{ article.categories | join: ', ' | jsonify }},
      "creators"   : {{ creator_names | join: ', ' | jsonify }},
      "description": {{ article.description | jsonify }},
      "image"      : {{ article.featured-image | jsonify }},
      "published"  : {{ article.published | jsonify }},
      "date"       : {{ article.date | jsonify }},
      "body"       : {{ article.content | strip_html | newline_to_br | replace: '<br />', ' ' | strip_newlines | normalize_whitespace | jsonify }}
    } {% unless forloop.last %},{% endunless %}
  {% endfor %}
]
